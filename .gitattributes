# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.php text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files
*.svg binary diff=exif
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.gz binary

# Shell scripts
*.sh text eol=lf
